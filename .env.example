# 服务端口
PORT=3000
# JWT 密钥,生产环境必须是至少 32 字节的随机值
JWT_SECRET=
# 访客显示 ID 的 HMAC 盐;可选,默认复用 JWT_SECRET,生产环境显式配置时至少 32 字节
GUEST_ID_SALT=
# Redis 地址;生产环境建议设置 REDIS_REQUIRED=true,连接失败则拒绝启动
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=tianyiba:
REDIS_REQUIRED=false
# 允许访问 API 的前端来源,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# 仅在应用确实位于一层可信反向代理之后时启用
TRUST_PROXY=false
# 数据库类型: pg（角色数据已迁移到 PostgreSQL，不再使用 SQLite 作为角色存储）
DB_CLIENT=pg
# PostgreSQL 连接串
DB_URL=postgres://tianyiba:tianyiba@localhost:5432/tianyiba
DB_POOL_MIN=2
DB_POOL_MAX=20

# 留空即关闭 Umami 统计。站点 ID 可在 Umami 网站设置中获取。
UMAMI_WEBSITE_ID=
# 自托管 Umami 时改为对应的脚本完整地址。
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
